        "label": "regions_bound"
      }
    },
    {
      "name": "hello",
      "expression": "res[\"llm\"].complete[mod.source()](prompt=\"hi\")",
      "meta": {
        "label": "hello"
      }
    },
    {
      "name": "inferred",
      "expression": "res[\"db\"].lookup(wf[\"keys\"])",
      "meta": {
        "label": "inferred"
      }
    },
    {
      "name": "region_table",
      "expression": "identity[mod.select(columns=[\"city\", \"value\"])](wf[\"regions\"])",
      "meta": {
        "label": "region_table"
      }
    }
  ]
