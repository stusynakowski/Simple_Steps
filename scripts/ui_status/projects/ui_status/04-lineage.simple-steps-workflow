{
  "format_version": 2,
  "id": "04-lineage",
  "name": "04 Lineage and the index",
  "meta": {
    "about": "D8, R9: the index shows core's # row id; each #<step> column is behind its own expander.",
    "plan": "docs/dev_plan/126-formula-ui.md"
  },
  "steps": [
    {
      "name": "r",
      "expression": "to_rows[mod.source()](data='{\"ward\": [\"A\", \"B\", \"A\", \"C\"], \"n\": [10, 20, 30, 40]}')",
      "meta": {
        "label": "r",
        "notes": "4 rows, ids 0-3."
      }
    },
    {
      "name": "filtered",
      "expression": "is_big[mod.filter()](wf[\"r\"])",
      "meta": {
        "label": "filtered",
        "notes": "Keeps ids 1,2,3: the index shows the gaps. No #r column: # is r's row. Today: the index shows 0,1,2."
      }
    },
    {
      "name": "sliced",
      "expression": "identity[mod.slice(start=1, stop=3)](wf[\"r\"])",
      "meta": {
        "label": "sliced",
        "notes": "Ids 1,2."
      }
    },
    {
      "name": "sorted",
      "expression": "identity[mod.sort(by=\"n\", ascending=False)](wf[\"r\"])",
      "meta": {
        "label": "sorted",
        "notes": "Ids 3,2,1,0, in that order."
      }
    },
    {
      "name": "distinct_wards",
      "expression": "identity[mod.distinct(columns=[\"ward\"])](wf[\"r\"])",
      "meta": {
        "label": "distinct_wards",
        "notes": "Ids 0,1,3; #r = [0,2],[1],[3] behind an expander."
      }
    },
    {
      "name": "split",
      "expression": "split_in_two[mod.expand()](wf[\"r\"])",
      "meta": {
        "label": "split",
        "notes": "Ids 0.0, 0.1, 1.0 ...; #r = the parent row behind an expander."
      }
    },
    {
      "name": "per_ward",
      "expression": "add_up[mod.collapse(by=\"ward\")](wf[\"r\"])",
      "meta": {
        "label": "per_ward",
        "notes": "Ids A, B, C; #r = the member rows."
      }
    },
    {
      "name": "stacked",
      "expression": "stack(wf[\"r\"], wf[\"filtered\"])",
      "meta": {
        "label": "stacked",
        "notes": "Two lineage columns, #r and #filtered, each behind its own expander; null where a row came from the other."
      }
    },
    {
      "name": "joined",
      "expression": "join(wf[\"r\"], wf[\"per_ward\"], on=\"ward\")",
      "meta": {
        "label": "joined",
        "notes": "#r and #per_ward."
      }
    },
    {
      "name": "chain_sort",
      "expression": "identity[mod.sort(by=\"n\", ascending=False)](wf[\"filtered\"])",
      "meta": {
        "label": "chain_sort",
        "notes": "Chain: filter -> sort keeps r's ids."
      }
    },
    {
      "name": "chain_split",
      "expression": "split_in_two[mod.expand()](wf[\"chain_sort\"])",
      "meta": {
        "label": "chain_split",
        "notes": "Lineage is one hop: #chain_sort only, not #r."
      }
    }
  ]
}
